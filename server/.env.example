# Copy to server/.env for local development (it's gitignored). In production, set these as
# Heroku config vars instead: heroku config:set NAME=value

# Port for the Express server. Heroku sets this automatically.
PORT=5000

# MongoDB connection string. Local default works with:
#   docker run -d -p 27017:27017 --name tracer-mongo mongo:8.2
# For Atlas, use the mongodb+srv:// string from the Atlas dashboard. It contains your
# password, so never commit it.
MONGODB_URI=mongodb://localhost:27017/tracer

# Optional, but strongly recommended: raises the OpenAlex daily budget 10x over keyless use.
# Free key from https://openalex.org/settings/api
OPENALEX_API_KEY=

# Optional: a contact email sent with Crossref requests, which moves them to Crossref's faster
# "polite" pool. Crossref supplies reference lists, including works not on OpenAlex.
CROSSREF_MAILTO=

# Optional: an OpenCitations access token (free, from https://opencitations.net/accesstoken).
# OpenCitations supplies open citation links, including some OpenAlex doesn't have.
OPENCITATIONS_ACCESS_TOKEN=

# Recommended: a contact email or URL sent with Wikidata requests, as Wikimedia's policy asks.
# Without one, Wikidata may throttle Tracer. Wikidata supplies authors' names in their own
# scripts (丸山眞男 for Masao Maruyama).
WIKIDATA_CONTACT=
